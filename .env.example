# Premier League Predictions Tracker - Environment Variables
# Copy this file to .env and configure your secrets locally

# YouTube Data v3 API Key (Required for live YouTube comments scraping)
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_V3_KEY_HERE

# Google Cloud OAuth 2.0 Web Client ID (Required for Admin Google Authentication)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com
